APP_NAME="NEWTIC Mağaza"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Normal merchant installation. External payment, shipping and mailing remain OFF.
NEWTIC_CHECKOUT_TEST_MODE=false
NEWTIC_PAYTR_CARD_PAYMENTS_ENABLED=false
NEWTIC_PAYTR_WEBHOOKS_ENABLED=false
NEWTIC_SHIPPING_DUMMY_ENABLED=false
NEWTIC_MARKETING_SEND_ENABLED=false
# Enable ONLY for first-install testing on a *.hostingersite.com domain.
# Must be false on a real customer domain; never enables live payments or shipping.
NEWTIC_INSTALL_ALLOW_HOSTINGER_TEMP_DOMAIN=false
# On fresh installations, enable SEO indexing in Admin > SEO only after launch checks.
NEWTIC_BANK_TRANSFER_EXPIRY_HOURS=48
